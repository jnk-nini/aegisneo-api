rules_version = '2';

// Production-mode rules: no browser or mobile client may read or write anything.
// Only the API server (Firebase Admin SDK + service account) reaches the data,
// and the Admin SDK is controlled by Google Cloud IAM, not by these rules.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
