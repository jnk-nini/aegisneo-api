# Copy to .env and fill in. Never commit .env.

# Neon: owner connection (setup and Phase 2 tasks) and limited app role (Phase 3)
NEON_DATABASE_URL=postgresql://neondb_owner:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
NEON_APP_URL=postgresql://aegis_app:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Supabase: limited app role through the Supavisor pooler, and the public Data API key
SUPABASE_APP_URL=postgresql://aegis_app.PROJECT_REF:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Firestore
FIREBASE_PROJECT_ID=your-project-id
GOOGLE_APPLICATION_CREDENTIALS=/path/outside/the/repo/aegis-api-key.json
