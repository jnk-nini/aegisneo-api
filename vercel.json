{
  "version": 2,
  "regions": [
    "sin1"
  ],
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/frontend(?:/(.*))?",
      "status": 308,
      "headers": {
        "Location": "https://aegisneo-hub.vercel.app/$1"
      }
    },
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ]
}
