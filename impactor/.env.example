# Copy to .env.local for local development (never commit .env.local).
# The dev server and the Vercel function both read these; neither is sent to the browser.

# Where the AegisNEO API runs. Locally: `python -m uvicorn index:app --port 8000` from the repo root.
AEGISNEO_API_URL=http://127.0.0.1:8000

# A key the API accepts (see AEGISNEO_API_KEYS in the API project).
AEGISNEO_API_KEY=
