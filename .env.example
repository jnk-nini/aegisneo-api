# Copy this file to .env and fill in real values. .env is ignored by git.
# On Vercel, set the first four as Environment Variables instead.

# Pooled connection string of the limited role aegis_app (host contains -pooler)
DATABASE_URL=postgresql://aegis_app:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Random 64-character hex string used to sign login tokens, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Optional: minutes a login token stays valid (default 60)
JWT_EXPIRE_MINUTES=60

# Partner sites that may read the full catalog (read-only), as client:key pairs
AEGISNEO_API_KEYS=impactor:KEY1,neo-atlas:KEY2

# Setup scripts only (import, create_user). Owner connection string, never set on Vercel.
DATABASE_OWNER_URL=
